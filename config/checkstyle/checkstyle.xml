<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Semantic rules for xlite-daemon.

  Layout is not here on purpose: Spotless owns indentation, line wrapping,
  import order and trailing whitespace, and google-java-format (AOSP) is the
  only thing allowed to decide them. Duplicating layout rules in two tools
  produces two answers to the same question and a fight no one wins.

  What remains is what a formatter cannot see: naming, brace requirements,
  forbidden constructs, empty blocks, and files that must not exist.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="NewlineAtEndOfFile"/>

    <module name="TreeWalker">
        <!-- Imports -->
            <!-- Import order is the formatter's call; see the comment in
                 config/checkstyle/checkstyle.xml. Only the checks the
                 formatter cannot make are declared here. -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun,com.sun"/>
        </module>

        <!-- Blocks and braces -->
        <module name="NeedBraces"/>
        <module name="LeftCurly">
            <property name="tokens"
                      value="CLASS_DEF,INTERFACE_DEF,ENUM_DEF,ANNOTATION_DEF,RECORD_DEF,CTOR_DEF,METHOD_DEF,COMPACT_CTOR_DEF,LITERAL_SWITCH,LITERAL_TRY,LITERAL_CATCH,LITERAL_FINALLY,LITERAL_SYNCHRONIZED,LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,LITERAL_WHILE,LITERAL_DO,STATIC_INIT"/>
        </module>
        <!-- A `case` body's brace is the formatter's call: colon-style cases
             get it on its own line, arrow-style cases keep it on the arrow's
             line. Neither placement is enforced here. -->
        <module name="RightCurly">
            <property name="option" value="same"/>
            <property name="tokens"
                      value="LITERAL_TRY,LITERAL_CATCH,LITERAL_FINALLY,LITERAL_IF,LITERAL_ELSE"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens"
                      value="LITERAL_CATCH,LITERAL_FINALLY,LITERAL_TRY,LITERAL_SYNCHRONIZED"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- Statements -->
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="NoFinalizer"/>

        <!-- Declarations -->
        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="InterfaceIsType"/>
        <module name="VisibilityModifier">
            <property name="protectedAllowed" value="true"/>
            <property name="packageAllowed" value="true"/>
        </module>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="PackageDeclaration"/>
        <module name="PackageName"/>

        <!-- Naming. Test methods carry a test<Behavior>_<Case> name by
             convention, so underscores are legal there and only there. -->
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ConstantName"/>

        <!-- Size. A method over these limits has to be decomposed, not
             annotated: they are the amount a reader can hold at once. -->
        <module name="MethodLength">
            <property name="max" value="100"/>
            <property name="countEmpty" value="false"/>
            <property name="tokens" value="METHOD_DEF,CTOR_DEF"/>
        </module>
        <module name="ExecutableStatementCount">
            <property name="max" value="25"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="4"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="4"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="4"/>
        </module>
        <!-- Method arity only: a value object's constructor takes as many
             arguments as the object has fields, and that is its schema, not
             a readability problem at the call site. -->
        <module name="ParameterNumber">
            <property name="max" value="4"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
    </module>
</module>
