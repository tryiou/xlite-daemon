# Editor defaults for this repository. Spotless owns final formatting for
# Java sources; this file keeps IDEs from fighting it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,xml,json,yml,yaml,properties}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.{sh}]
indent_size = 2
